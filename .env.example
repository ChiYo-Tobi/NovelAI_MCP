# Copy to .env (not tracked); replace both placeholders before starting Compose.
# Server-side key for anonymous generation only. Never put it in client configs.
DEFAULT_NOVELAI_API_KEY=SERVER_DEFAULT_API_KEY
# Name of the EXISTING private Docker network that contains qiandaiapi-app.
MCP_DOCKER_NETWORK=YOUR_EXISTING_PRIVATE_NETWORK

UPSTREAM_BASE_URL=http://qiandaiapi-app:8080
MCP_ALLOWED_ORIGINS=*
MCP_IMAGE_PUBLIC_BASE_URL=https://api.chiyotobi.party/mcp
MCP_IMAGE_TTL_SECONDS=300
# Container port stays at 3000; only the host's loopback port is configurable.
PORT=3000
MCP_HOST_PORT=13000
# Compose fixes MCP_DATA_DIR and MCP_IMAGE_ARCHIVE_DIR to distinct named volumes.
# For a native (non-Docker) run, set two dedicated directories and bind to loopback:
# MCP_BIND_HOST=127.0.0.1
# MCP_DATA_DIR=./data
# MCP_IMAGE_ARCHIVE_DIR=./outputs

# Optional: use a unique image tag for each release and keep the last good one.
# MCP_IMAGE_TAG=RELEASE_TAG
