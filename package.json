{
  "name": "novelai-mcp-server",
  "version": "2.0.0",
  "description": "Streamable HTTP MCP server for Qiandai's NovelAI image and balance APIs",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist",
    "prompts/novelAI_prompt.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "start:http": "node --env-file-if-exists=.env dist/streamable-http-server.js",
    "test": "node --test tests/*.test.mjs"
  },
  "keywords": [
    "mcp",
    "novelai",
    "image-generation",
    "ai",
    "nai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@msgpack/msgpack": "^3.1.3",
    "adm-zip": "0.6.1",
    "ajv": "^8.20.0",
    "cors": "2.8.6",
    "express": "5.3.0",
    "https-proxy-agent": "^7.0.6",
    "node-fetch": "^3.3.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.2"
  }
}
